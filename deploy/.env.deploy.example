# =============================================================================
# TokenHub 部署环境变量模板
# 用法：cp .env.deploy.example .env  然后把下面每个值填成你自己的。
# 生成随机密钥：openssl rand -hex 32
# 注意：.env 含机密，不要提交到仓库、不要外发。
# =============================================================================

# ---- 镜像（一般不用改；换 tag 或私有 fork 时才改）----
APP_IMAGE=ghcr.io/olibazeva363-ops/haochi:latest

# ---- 对外端口 ----
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release

# ---- PostgreSQL（必填 PASSWORD）----
POSTGRES_USER=tokenhub
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=tokenhub

# ---- Redis（可留空表示无密码；公网务必设密码）----
REDIS_PASSWORD=

# ---- 首个管理员（首次启动自动创建，必填 PASSWORD）----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---- 安全密钥（必填，各用 openssl rand -hex 32 生成一个）----
# 固定值，别每次改，否则登录态/2FA 会全部失效
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
TOTP_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- Claude 单账号 Worker（可选）----
# 仅在使用 generate-claude-workers.sh 生成的 Compose 覆盖文件时需要。
# 生成方式：openssl rand -hex 32
CLAUDE_WORKER_SHARED_SECRET=

# ---- Watchtower 读取的 docker 登录凭据目录（默认即可）----
# 服务器执行过 `docker login ghcr.io` 后，凭据在 ~/.docker/config.json
DOCKER_CONFIG_DIR=~/.docker
